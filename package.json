{
  "name": "pope",
  "private": true,
  "description": "Sistema de gestión de cibercafés (monorepo)",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.11.0 <25",
    "pnpm": ">=12.4.2"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "prettier --check . && eslint --max-warnings=0 eslint.config.mjs && turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "turbo": "~2.11.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
